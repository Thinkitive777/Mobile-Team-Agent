# Dependencies — installed locally via `npm install`, never committed
node_modules/

# Build output — prebuilt binaries are produced on demand, never committed
dist/

# Distributable archives — built on demand, never committed
*.zip

# Environment / secrets
.env
.env.local
*.local

# OS / editor cruft
.DS_Store
Thumbs.db
*.swp
.idea/
.vscode/

# Logs
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
